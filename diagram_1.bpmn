<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Lakehouse_Fixed" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="4.11.1">
  <bpmn:process id="ecommerce_batch_lakehouse_pipeline" name="E-Commerce Batch Lakehouse" isExecutable="true">
    <bpmn:startEvent id="Start_Timer" name="Daily Scheduled Trigger (Airflow)">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Ingest" name="1. Ingest Raw JSON (Python Boto3)">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Bronze">
        <bpmn:targetRef>Store_Bronze</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="Store_Bronze" name="MinIO: Bronze (JSON)" />
    <bpmn:serviceTask id="Task_Bronze_Silver" name="2. PySpark: Bronze to Silver (Parquet)">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:property id="P_Bronze_Read" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Bronze">
        <bpmn:sourceRef>Store_Bronze</bpmn:sourceRef>
        <bpmn:targetRef>P_Bronze_Read</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DOA_Silver">
        <bpmn:targetRef>Store_Silver</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="Store_Silver" name="MinIO: Silver (Parquet)" />
    <bpmn:exclusiveGateway id="Gateway_Valid" name="Quality Check Passed?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F_Valid_Yes</bpmn:outgoing>
      <bpmn:outgoing>F_Valid_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Silver_Gold" name="3. PySpark: Aggregate Metrics">
      <bpmn:incoming>F_Valid_Yes</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:property id="P_Silver_Read" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Silver">
        <bpmn:sourceRef>Store_Silver</bpmn:sourceRef>
        <bpmn:targetRef>P_Silver_Read</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_Fork" name="Parallel Store">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F_Fork_A</bpmn:outgoing>
      <bpmn:outgoing>F_Fork_B</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_Write_Gold_S3" name="4a. Save Parquet (MinIO Gold)">
      <bpmn:incoming>F_Fork_A</bpmn:incoming>
      <bpmn:outgoing>F_Join_A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Write_Postgres" name="4b. Write Datamart (PostgreSQL JDBC)">
      <bpmn:incoming>F_Fork_B</bpmn:incoming>
      <bpmn:outgoing>F_Join_B</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Postgres">
        <bpmn:targetRef>Store_Postgres</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="Store_Postgres" name="Postgres: datamart" />
    <bpmn:parallelGateway id="Gateway_Join" name="Sync Completion">
      <bpmn:incoming>F_Join_A</bpmn:incoming>
      <bpmn:incoming>F_Join_B</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="End_Success" name="ETL Succeeded">
      <bpmn:incoming>F5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Alert" name="Send Failure Notification">
      <bpmn:incoming>F_Valid_No</bpmn:incoming>
      <bpmn:outgoing>F_Alert_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Fail" name="ETL Failed Alert">
      <bpmn:incoming>F_Alert_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Timer" targetRef="Task_Ingest" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Ingest" targetRef="Task_Bronze_Silver" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Bronze_Silver" targetRef="Gateway_Valid" />
    <bpmn:sequenceFlow id="F_Valid_Yes" name="Valid" sourceRef="Gateway_Valid" targetRef="Task_Silver_Gold" />
    <bpmn:sequenceFlow id="F_Valid_No" name="Invalid" sourceRef="Gateway_Valid" targetRef="Task_Alert" />
    <bpmn:sequenceFlow id="F_Alert_End" sourceRef="Task_Alert" targetRef="End_Fail" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Silver_Gold" targetRef="Gateway_Fork" />
    <bpmn:sequenceFlow id="F_Fork_A" sourceRef="Gateway_Fork" targetRef="Task_Write_Gold_S3" />
    <bpmn:sequenceFlow id="F_Fork_B" sourceRef="Gateway_Fork" targetRef="Task_Write_Postgres" />
    <bpmn:sequenceFlow id="F_Join_A" sourceRef="Task_Write_Gold_S3" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="F_Join_B" sourceRef="Task_Write_Postgres" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="F5" sourceRef="Gateway_Join" targetRef="End_Success" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="ecommerce_batch_lakehouse_pipeline">
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5">
        <di:waypoint x="1270" y="300" />
        <di:waypoint x="1320" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Join_B_di" bpmnElement="F_Join_B">
        <di:waypoint x="1170" y="365" />
        <di:waypoint x="1245" y="365" />
        <di:waypoint x="1245" y="325" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Join_A_di" bpmnElement="F_Join_A">
        <di:waypoint x="1170" y="255" />
        <di:waypoint x="1245" y="255" />
        <di:waypoint x="1245" y="275" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Fork_B_di" bpmnElement="F_Fork_B">
        <di:waypoint x="955" y="325" />
        <di:waypoint x="955" y="365" />
        <di:waypoint x="1030" y="365" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Fork_A_di" bpmnElement="F_Fork_A">
        <di:waypoint x="955" y="275" />
        <di:waypoint x="955" y="255" />
        <di:waypoint x="1030" y="255" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4">
        <di:waypoint x="880" y="300" />
        <di:waypoint x="930" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Alert_End_di" bpmnElement="F_Alert_End">
        <di:waypoint x="830" y="430" />
        <di:waypoint x="870" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Valid_No_di" bpmnElement="F_Valid_No">
        <di:waypoint x="665" y="325" />
        <di:waypoint x="665" y="430" />
        <di:waypoint x="710" y="430" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="664" y="368" width="33" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Valid_Yes_di" bpmnElement="F_Valid_Yes">
        <di:waypoint x="690" y="300" />
        <di:waypoint x="740" y="300" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="703" y="275" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3">
        <di:waypoint x="590" y="300" />
        <di:waypoint x="640" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2">
        <di:waypoint x="390" y="300" />
        <di:waypoint x="450" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="196" y="300" />
        <di:waypoint x="250" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Start_Timer_di" bpmnElement="Start_Timer">
        <dc:Bounds x="160" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="138" y="318" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Ingest_di" bpmnElement="Task_Ingest">
        <dc:Bounds x="250" y="260" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Bronze_Silver_di" bpmnElement="Task_Bronze_Silver">
        <dc:Bounds x="450" y="260" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Valid_di" bpmnElement="Gateway_Valid" isMarkerVisible="true">
        <dc:Bounds x="640" y="275" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="630" y="325" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Silver_Gold_di" bpmnElement="Task_Silver_Gold">
        <dc:Bounds x="740" y="260" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Fork_di" bpmnElement="Gateway_Fork">
        <dc:Bounds x="930" y="275" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="922" y="325" width="67" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Write_Gold_S3_di" bpmnElement="Task_Write_Gold_S3">
        <dc:Bounds x="1030" y="220" width="140" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Write_Postgres_di" bpmnElement="Task_Write_Postgres">
        <dc:Bounds x="1030" y="330" width="140" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Store_Postgres_di" bpmnElement="Store_Postgres">
        <dc:Bounds x="1075" y="430" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1077" y="480" width="47" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Join_di" bpmnElement="Gateway_Join">
        <dc:Bounds x="1220" y="275" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1203" y="325" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Success_di" bpmnElement="End_Success">
        <dc:Bounds x="1320" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1299" y="318" width="79" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Alert_di" bpmnElement="Task_Alert">
        <dc:Bounds x="710" y="400" width="120" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Fail_di" bpmnElement="End_Fail">
        <dc:Bounds x="870" y="412" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="848" y="448" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Store_Silver_di" bpmnElement="Store_Silver">
        <dc:Bounds x="640" y="85" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="633" y="135" width="65" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Store_Bronze_di" bpmnElement="Store_Bronze">
        <dc:Bounds x="395" y="405" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="385" y="455" width="71" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="DOA_Bronze_di" bpmnElement="DOA_Bronze">
        <di:waypoint x="348" y="340" />
        <di:waypoint x="398" y="405" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DIA_Bronze_di" bpmnElement="DIA_Bronze">
        <di:waypoint x="445" y="405" />
        <di:waypoint x="481" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DOA_Silver_di" bpmnElement="DOA_Silver">
        <di:waypoint x="549" y="260" />
        <di:waypoint x="645" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DIA_Silver_di" bpmnElement="DIA_Silver">
        <di:waypoint x="686" y="135" />
        <di:waypoint x="775" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DOA_Postgres_di" bpmnElement="DOA_Postgres">
        <di:waypoint x="1100" y="400" />
        <di:waypoint x="1100" y="430" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
