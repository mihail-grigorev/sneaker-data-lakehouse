# Airflow Webserver Security Key (generate with: openssl rand -hex 32)
AIRFLOW__WEBSERVER__SECRET_KEY=sneakers_dev_secret_key_change_me_in_prod

# Airflow Admin Credentials (used during initial container bootstrapping)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_this_admin_password
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User

# PostgreSQL Metadata & Datamart Configuration
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=airflow
POSTGRES_PORT=15432

# Object Storage / S3 / MinIO / RustFS Configuration
AWS_ACCESS_KEY_ID=change_this_s3_access_key
AWS_SECRET_ACCESS_KEY=change_this_s3_secret_key
AWS_ENDPOINT_URL=http://s3:9000
AWS_DEFAULT_REGION=us-east-1
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
